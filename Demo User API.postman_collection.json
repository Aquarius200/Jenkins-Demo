{
  "info": {
    "_postman_id": "a7d94d31-c987-41fd-861c-e9b10e9deb70",
    "name": "Demo User API",
    "description": "demo_project 用户 API：登录、用户 CRUD，数据存于内存。\n\n服务地址：http://localhost:11011",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "25138424"
  },
  "item": [
    {
      "name": "认证",
      "item": [
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. 解析登录返回的响应体",
                  "const res = pm.response.json();",
                  "",
                  "// 2. 断言登录成功（基础校验，自动化必加）",
                  "pm.test(\"登录接口状态码200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"登录业务返回成功\", function () {",
                  "    pm.expect(res.code).to.eql(200);",
                  "    pm.expect(res.msg).to.eql(\"success\");",
                  "});",
                  "",
                  "// 3. 把token存入当前环境变量（你右侧环境选的是Demo User API，就写入这个环境）",
                  "pm.environment.set(\"auth_token\", res.data.token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "用户登录获取 token。Tests 脚本会自动将 data.token 保存到 collection 变量，供后续请求使用。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "用户管理",
      "item": [
        {
          "name": "获取当前用户信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "user"
              ]
            },
            "description": "根据 token 获取当前登录用户信息"
          },
          "response": []
        },
        {
          "name": "获取用户列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "获取所有用户列表"
          },
          "response": []
        },
        {
          "name": "创建用户",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"pass123\",\n  \"email\": \"new@demo.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "创建新用户"
          },
          "response": []
        },
        {
          "name": "获取指定用户",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "1"
              ]
            },
            "description": "根据用户ID获取用户详情"
          },
          "response": []
        },
        {
          "name": "更新用户",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"updated@demo.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "1"
              ]
            },
            "description": "更新指定用户信息"
          },
          "response": []
        },
        {
          "name": "删除用户",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "1"
              ]
            },
            "description": "删除指定用户"
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
